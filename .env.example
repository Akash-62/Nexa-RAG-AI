# ─── App ───────────────────────────────────────────────────────────────────────
APP_NAME="Nexa RAG Agent Platform"
DEBUG=false

# ─── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=nexarag
POSTGRES_PASSWORD=nexarag_dev
POSTGRES_DB=nexarag
DATABASE_URL=postgresql://nexarag:nexarag_dev@db:5432/nexarag

# ─── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-real-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── LLM Provider ──────────────────────────────────────────────────────────────
# Options: openai | anthropic | gemini
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...

# ─── Embeddings ────────────────────────────────────────────────────────────────
# Options: openai | local (sentence-transformers)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# ─── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=documents

# ─── File Upload ───────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
